APP_NAME=SimPhix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartweb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Banking & Virtual Accounts — Fintava / Loma Bank (Primary Provider)
# --------------------------------------------------------------------------
FINTAVA_BASE_URL=https://dev.fintavapay.com/api/dev
FINTAVA_API_KEY=
FINTAVA_WEBHOOK_SECRET=
FINTAVA_MASTER_SOURCE_ID=
FINTAVA_MERCHANT_ACCOUNT=
FINTAVA_PAYOUT_ENDPOINT=bank/credit/merchant
FINTAVA_INTERNAL_EMAIL_DOMAIN=simphix.ng

# --------------------------------------------------------------------------
# SMS & Communications — Termii
# --------------------------------------------------------------------------
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_API_KEY=
TERMII_SENDER_ID=SimPhix

# --------------------------------------------------------------------------
# Push Notifications (WebPush / PWA VAPID)
# --------------------------------------------------------------------------
VAPID_SUBJECT="${APP_URL}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --------------------------------------------------------------------------
# Telecom & SME Data Integrations
# --------------------------------------------------------------------------
GOGOZ_BASE_URL=https://www.gongozconcept.com/api/data/
GOGOZ_API_KEY=

SMEPLUG_BASE_URL=https://smeplug.ng/api/v1
SMEPLUG_API_KEY=

AREWA_BASE_URL=
AREWA_API_TOKEN=

AMSUB_BASE_URL=https://amsubapi.com/api
AMSUB_API_KEY=

# Legacy SME Data (Fadeel)
BASE_URL=https://fadeelposdatasub.com.ng/api/data/purchase
API_KEYS=

# --------------------------------------------------------------------------
# Utility & Bill Payments — VTPass
# --------------------------------------------------------------------------
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_PAYMENT_URL=https://sandbox.vtpass.com/api/pay
VTPASS_VARIATION_URL=https://sandbox.vtpass.com/api/service-variations?serviceID=
VTPASS_VERIFY_JAMB_URL=https://sandbox.vtpass.com/api/verify-jamb
VTPASS_BILLER_CODE=

# --------------------------------------------------------------------------
# Legacy Banking Integration — PalmPay (Fallback / Webhook)
# --------------------------------------------------------------------------
BASE_URL_PALMPAY=https://open-gw-prod.palmpay-inc.com/
BEARER_TOKEN=
MERCHANTID=
VERSION=V2.0
NOTIFY_URL=

# --------------------------------------------------------------------------
# AWS S3 / Cloud Storage (Optional)
# --------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Third-Party Mail Services (Optional)
# --------------------------------------------------------------------------
POSTMARK_API_KEY=
RESEND_API_KEY=

# --------------------------------------------------------------------------
# Slack Notifications (Optional)
# --------------------------------------------------------------------------
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# --------------------------------------------------------------------------
# Frontend Assets
# --------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
